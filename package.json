{
  "name": "ClaudianBridge",
  "version": "0.30.2",
  "description": "Unified Claudian integration: text-to-Claudian, TTS, Office-to-Markdown, extension whitelist",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production && node scripts/deploy.mjs",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "tsc -noEmit",
    "bundle:edge-tts": "git subtree pull --prefix=py/edge_tts https://github.com/rany2/edge-tts.git 7.2.8 --squash"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "jsdom": "^30.0.1",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
