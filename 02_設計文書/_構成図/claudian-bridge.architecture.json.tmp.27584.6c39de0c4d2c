  "cards": [
    {
      "dot": "cyan",
      "title": "核心分层",
      "items": [
        "main.ts 在 onload 中按固定顺序装配全部功能与标签页",
        "core/config-store.ts 持有唯一 data.json（原子写 + fs.watch 外部变更监听）",
        "settings/ 为单页内切的 8 个设置标签页，配置读写统一经由 ConfigStore"
      ]
    },
    {
      "dot": "emerald",
      "title": "功能单元",
      "items": [
        "selection · object：选中文本与右键对象注入 Claudian 输入框",
        "tts · llm：三引擎朗读、报告自动播报、claude -p 指令整形",
        "office · chroma：均以 Python 子进程完成格式转换与向量库检索",
        "quota：Anthropic / DeepSeek / Kimi / MiniMax / Zhipu 五家余额轮询"
      ]
    },
    {
      "dot": "amber",
      "title": "边界与迁移",
      "items": [
        "legacy/ 把旧 4 个插件的 data.json 转换后写入新 SSOT",
        "对外仅三条通道：realclaudian 内部 API、Python spawn、HTTPS 请求"
      ]
    }
  ]
